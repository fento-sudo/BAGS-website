---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config.js';

const { title, description, current = '', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    <!-- Vercel Web Analytics: switch it on in the Vercel dashboard (Analytics tab). -->
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // The Minutes: post straight to MailerLite without leaving the page.
      document.querySelectorAll('form[data-minutes]').forEach((form) => {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const status = form.querySelector('.minutes-form__status');
          const button = form.querySelector('button');
          const input = form.querySelector('input[type="email"]');
          if (!input.checkValidity()) {
            status.textContent = 'That email address looks incomplete. Check it and try again.';
            input.focus();
            return;
          }
          button.disabled = true;
          try {
            await fetch(form.action, { method: 'POST', body: new FormData(form), mode: 'no-cors' });
            form.querySelector('.minutes-form__row').hidden = true;
            // COPY TO CONFIRM: success message shown after signing up.
            status.textContent = "You're on the list. The Minutes arrive after the last Friday of the month.";
          } catch (err) {
            status.textContent = "That didn't go through. Check your connection and try again.";
            button.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
